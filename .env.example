# ============================================
# Variables para Render (Web Service - Docker)
# Configúralas en: Dashboard → tu servicio → Environment
# ============================================

# Puerto (Render lo asigna automáticamente; no suele hacer falta cambiarlo)
PORT=8080

# Perfil Spring en producción
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL (Render)
# URL EXTERNA (desde tu PC) o INTERNA (desde otro servicio Render en la misma región)
# Añade ?sslmode=require si conectas desde fuera de Render
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/NOMBRE_DB?sslmode=require
SPRING_DATASOURCE_USERNAME=medico_user
SPRING_DATASOURCE_PASSWORD=tu_password_seguro

# JWT (mínimo 32 caracteres, único y secreto)
JWT_SECRET=GeneraUnaClaveLargaAleatoriaMinimo32Caracteres123
JWT_EXPIRATION=86400000

# Orígenes del frontend en Vercel (sin espacios, separados por coma)
CORS_ORIGINS=https://tu-proyecto.vercel.app,http://localhost:4200
